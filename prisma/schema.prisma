// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  prefix    String   @default(";")
  modules   Json?
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Case {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  moderatorId  String
  action       String   // "ban" | "kick" | "mute" | "warn" | "timeout"
  reason       String?  // editable via ;reason
  durationMs   Int?     // editable via ;duration (mute/timeout)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([guildId, userId])
}

model Economy {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
}
